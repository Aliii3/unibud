{
  "name": "unibud",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "build:android": "npm run check:routes && npx eas-cli build --platform android --profile production",
    "build:ios": "npm run check:routes && npx eas-cli build --platform ios --profile production",
    "build:preview": "npm run check:routes && npx eas-cli build --platform all --profile preview",
    "check:listing": "python3 scripts/check_listing.py",
    "check:routes": "node tests/routes.test.mjs",
    "icons": "python3 scripts/build_icons.py",
    "ios": "expo start --ios",
    "native:ios": "expo prebuild --platform ios --clean",
    "screenshots": "node scripts/capture_screens.mjs && python3 scripts/build_screenshots.py",
    "site": "rm -rf site && mkdir -p site && cp docs/index.html docs/privacy.html site/ && echo 'site/ is ready - drag it onto https://app.netlify.com/drop'",
    "spec": "python3 spec/build_spec.py",
    "start": "expo start",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "test:schema": "node tests/schema.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "xcode": "open ios/*.xcworkspace"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3"
  }
}
